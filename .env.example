# This repo is API class. Non-secret config only.
# App secrets (provider API keys) live in Infisical, not here and not in Git.

# Which baked config template the entrypoint seeds on first boot.
CCS_ENV=prod

# Where the gateway reads config from. In the container this is a volume.
CCS_CONFIG_DIR=/app/config

# Port the gateway listens on. Must match platform.yaml service.port.
PORT=7896

# Public origin, used by the dashboard to call the API on the same origin.
APP_URL=https://api.llmbridge.shrijit.tech

# Upstream LLM providers this gateway fronts. Populated at runtime from
# Infisical-backed config; see config/config.prod.json for the shape.
CCS_DEFAULT_PROVIDER=anthropic