#!/usr/bin/env bash
# Uniform fleet health gate: exactly GET /health -> {status,service,version,checks}
# (standards/platform.md#health). Accepts ok (healthy) or degraded (up but
# cannot serve traffic: no providers configured). A 503/status down means the
# store is unreadable and must keep failing the gate.
set -euo pipefail
: "${APP_URL:?APP_URL is required}"

body=$(curl -fsS --max-time 20 "$APP_URL/health")

case "$body" in
  *'"status":"ok"'*|*'"status":"degraded"'*) ;;
  *)
    echo "FAIL: $APP_URL/health did not report status ok or degraded"
    echo "$body"
    exit 1
    ;;
esac

echo "healthy: $APP_URL/health -> $body"

# Optional deploy-gate pin: when EXPECTED_VERSION is set (CI passes the image's
# git SHA), the gate only passes once the NEW container answers. Without this,
# a healthy-but-stale container would pass the gate.
if [ -n "${EXPECTED_VERSION:-}" ]; then
  case "$body" in
    *"\"version\":\"$EXPECTED_VERSION\"") ;;
    *)
      echo "FAIL: $APP_URL/health version mismatch (expected $EXPECTED_VERSION)"
      echo "$body"
      exit 1
      ;;
  esac
  echo "version: $EXPECTED_VERSION confirmed"
fi

# The dashboard SPA is baked into the same image at /dashboard. It is a static
# mount, so it comes up exactly when the gateway does; assert it so a broken
# image (missing dashboard/dist) cannot pass the gate.
dash_code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 "$APP_URL/dashboard" || echo 000)
[ "$dash_code" = "200" ] || {
  echo "FAIL: $APP_URL/dashboard returned $dash_code (dashboard bundle missing?)"
  exit 1
}
echo "healthy: dashboard SPA served at $APP_URL/dashboard"
